# --- Required for extraction, chat and comparison judgments (set ONE provider's key) ---
ANTHROPIC_API_KEY=
# Google Gemini key from https://aistudio.google.com/apikey (GOOGLE_API_KEY also works)
GEMINI_API_KEY=

# --- Model roles ("provider:model"). Providers: anthropic, gemini, fake (offline tests) ---
# To use Gemini instead of Claude, set all four to e.g. gemini:gemini-flash-latest
# (or gemini:gemini-pro-latest for higher quality).
# All roles default to Claude Opus 5.5. For lower cost, point extraction/fast at
# anthropic:claude-sonnet-5-5 or anthropic:claude-haiku-5-5.
LLM_GENERATION_MODEL=anthropic:claude-opus-5-5
LLM_EXTRACTION_MODEL=anthropic:claude-opus-5-5
LLM_VISION_MODEL=anthropic:claude-opus-5-5
LLM_FAST_MODEL=anthropic:claude-opus-5-5
# Anthropic only: re-run refused requests on Anthropic's recommended fallback model ("default") or "off"
LLM_REFUSAL_FALLBACK=default

# --- Local retrieval models (downloaded on first use into the `models` volume) ---
EMBEDDING_MODEL=local:BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=local:BAAI/bge-reranker-v2-m3
IMAGE_EMBEDDING_MODEL=local:clip-ViT-B-32

# --- Visual rule checks (clear space, lockups, placement, misuse; uses LLM_VISION_MODEL) ---
# VISUAL_CHECKS=true
# VISUAL_MAX_REFERENCE_PAGES=30   # guide pages read for diagrams
# VISUAL_MAX_CANDIDATE_PAGES=20   # candidate pages checked per comparison
# VISUAL_MIN_CONFIDENCE=0.6

# --- Retrieval tuning ---
RETRIEVAL_CANDIDATES=50
RERANK_TOP_K=6
# RERANK_THRESHOLD=0.15   # default depends on the reranker

# --- Local dev outside Docker (defaults shown) ---
# DATABASE_URL=postgresql+asyncpg://stylelens:stylelens@localhost:5432/stylelens
# REDIS_URL=redis://localhost:6379/0
# STORAGE_BACKEND=local        # or s3
# JOB_MODE=arq                 # or inline (run jobs inside the API process)
